# Build context excludes — keep the image build fast and reproducible.
# NOTE: do NOT ignore *.astro here; those are the site's source components
# and must reach the build stage.

.git
.github
node_modules
dist
.astro

# Local env / editor / OS noise
.env
.env.*
.DS_Store
*.log

# Docs and CI that don't affect the build
docs
